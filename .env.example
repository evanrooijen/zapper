DATABASE_URL=postgresql://app:app@localhost:5432/app
DB_DRIVER=postgres
BETTER_AUTH_URL=http://localhost:3000
# Generate your own value: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional: enable GitHub linking and login for linked accounts (server-only credentials)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required to validate favorites (server-only; https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=
